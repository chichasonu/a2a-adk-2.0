# ---- Oracle -----------------------------------------------------------------
ORACLE_USER=app_user
ORACLE_PASSWORD=secret
ORACLE_DSN=dbhost:1521/ORCLPDB1
ORACLE_SCHEMA=APP
ORACLE_TABLE=CUSTOMERS
# Optional: restrict / override the extraction
# ORACLE_WHERE=CREATED_AT >= DATE '2024-01-01'
# ORACLE_QUERY=SELECT ... FROM ...
# ORACLE_ARRAYSIZE=50000
# ORACLE_THICK_MODE=false
# ORACLE_CLIENT_LIB_DIR=

# ---- BigQuery (service account JSON) ----------------------------------------
BQ_PROJECT=my-gcp-project
BQ_DATASET=analytics
BQ_TABLE=customers
# Path to the service account key file...
BQ_CREDENTIALS_JSON=/path/to/service-account.json
# ...or the JSON content itself (useful in CI)
# BQ_CREDENTIALS_JSON_CONTENT={"type":"service_account",...}
# BQ_LOCATION=US
# BQ_WHERE=created_at >= '2024-01-01'
# BQ_QUERY=SELECT ... FROM ...

# ---- Comparison -------------------------------------------------------------
# Comma-separated primary key column(s). Auto-detected from the Oracle PK if omitted.
COMPARE_JOIN_COLUMNS=CUSTOMER_ID
# COMPARE_IGNORE_COLUMNS=LOAD_TS,ETL_BATCH_ID
# COMPARE_ABS_TOL=0
# COMPARE_REL_TOL=0
# COMPARE_IGNORE_CASE=false
# COMPARE_IGNORE_SPACES=true
# Max mismatching rows handed to datacompy for the detailed report
# COMPARE_SAMPLE_ROWS=10000
# Run datacompy over the *full* dataset when both sides are at most this many rows
# COMPARE_FULL_DATACOMPY_MAX_ROWS=500000
# COMPARE_OUTPUT_DIR=reports

# ---- DuckDB -----------------------------------------------------------------
# On-disk database so multi-million row extracts spill to disk instead of RAM
# DUCKDB_PATH=compare.duckdb
# DUCKDB_MEMORY_LIMIT=4GB
# DUCKDB_THREADS=4
