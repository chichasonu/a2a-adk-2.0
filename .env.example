# Copy this file to .env and fill in the keys you have. Nothing here is required to boot the
# app — any demo whose key is missing runs in simulated mode (clearly badged in the UI).

# Jev (TypeSafe) — https://typesafe.ai — powers every "Jev" step in every demo
TYPESAFE_API_KEY=

# OpenRouter — https://openrouter.ai/keys — one key powers both LLM providers:
# Claude (Haiku 4.5 / Sonnet 5 / Opus 5) and Kimi (K2.6 / K3)
OPENROUTER_API_KEY=

# Optional: override the OpenRouter endpoint (default https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=

# Optional: port the server listens on (default 3000)
PORT=3000

# Optional: hard cap in USD on real LLM spend for this server session (default 0.50).
# Once hit, paid LLM calls fall back to clearly badged simulated output. Jev itself is
# ~$0.02-0.04 per 1,000 decisions and is never blocked by this cap.
DEMO_BUDGET_USD=0.50

# ── Public hosting (see README, "Hosting it publicly") ──
# HOSTED=1 makes the server ignore every key above, so visitors must bring their own.
HOSTED=
# Requests per minute per IP (default 600 when HOSTED=1, unlimited locally). Set TRUST_PROXY=1 behind a reverse proxy.
RATE_LIMIT_PER_MIN=
TRUST_PROXY=
