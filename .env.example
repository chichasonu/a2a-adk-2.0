# Required
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional - Redis used for durable session memory
# Set USE_FAKEREDIS=true to use an embedded in-memory Redis (fakeredis)
USE_FAKEREDIS=false
REDIS_URL=redis://localhost:6379/0

# Optional - Gemini model (defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Optional - application name
APP_NAME=a2a-adk-2-0

# Optional - A2A public URL used in the agent cards
A2A_AGENT_URL=http://localhost:8000/a2a/team-agent
A2A_BASE_URL=http://localhost:8000

# Optional - MCP integration
MCP_ENABLED=true
MCP_SERVER_URL=http://localhost:8080/mcp
# Set this if the MCP server is protected by an API key / Bearer token.
MCP_API_KEY=

# Optional - API key / Bearer token auth for the ADK FastAPI and A2A endpoints.
# Leave empty to disable auth. When set, clients must send:
#   X-API-Key: <your-key>
# or
#   Authorization: Bearer <your-key>
API_KEY=

# Optional - server port
PORT=8000

# ---------------------------------------------------------------------------
# Oracle <-> BigQuery data comparison app (data_compare, datacompy)
# ---------------------------------------------------------------------------

# Oracle source
ORACLE_USER=app_user
ORACLE_PASSWORD=
ORACLE_DSN=localhost:1521/FREEPDB1
ORACLE_SCHEMA=
ORACLE_TABLE=FEEDBACK
# Optional row filter, or a full query that overrides table/where
ORACLE_WHERE=
ORACLE_QUERY=
ORACLE_ARRAYSIZE=5000
# Thick mode requires the Oracle Instant Client libraries
ORACLE_THICK_MODE=false
ORACLE_CLIENT_LIB_DIR=

# BigQuery source (service account credentials)
BQ_PROJECT=my-gcp-project
BQ_DATASET=analytics
BQ_TABLE=FeedBack
BQ_LOCATION=
BQ_WHERE=
BQ_QUERY=
# Path to the service account JSON key file
BQ_CREDENTIALS_JSON=/path/to/service-account.json
# Or the JSON content itself (useful for CI secrets); takes precedence
BQ_CREDENTIALS_JSON_CONTENT=

# Comparison options
COMPARE_JOIN_COLUMNS=chatmessageid
COMPARE_IGNORE_COLUMNS=
COMPARE_ABS_TOL=0
COMPARE_REL_TOL=0
COMPARE_IGNORE_CASE=false
COMPARE_IGNORE_SPACES=true
COMPARE_SAMPLE_COUNT=10
COMPARE_OUTPUT_DIR=compare_reports
